generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  ORDER_MANAGER
  CONTENT_MANAGER
  MARKETING_MANAGER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PromotionTarget {
  ALL
  FIRST_ORDER
  ABANDONED_CART
  CAMPAIGN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryAdjustmentReason {
  PURCHASE
  SALE
  RETURN
  DAMAGED
  CORRECTION
  INITIAL
}

// ─── Customer / Auth ─────────────────────────────────────────────────────────

model User {
  id                String          @id @default(cuid())
  email             String          @unique
  emailVerified     Boolean         @default(false)
  passwordHash      String?
  name              String?
  phone             String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  newsletterOptIn   Boolean         @default(false)
  whatsappOptIn     Boolean         @default(false)
  profile           CustomerProfile?
  addresses         Address[]
  orders            Order[]
  cart              Cart?
  wishlist          Wishlist?
  reviews           Review[]
  recentlyViewed    RecentlyViewed[]
  abandonedCarts    AbandonedCartEvent[]
  couponRedemptions CouponRedemption[]

  @@index([email])
}

model CustomerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl      String?
  dateOfBirth    DateTime?
  notes          String?
  totalOrders    Int      @default(0)
  lifetimeValue  Decimal  @default(0) @db.Decimal(12, 2)
  avgOrderValue  Decimal  @default(0) @db.Decimal(12, 2)
  lastOrderAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]

  @@index([userId])
}

// ─── Admin ───────────────────────────────────────────────────────────────────

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         AdminRole  @default(MANAGER)
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model AuditLog {
  id           String    @id @default(cuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id])
  action       String
  entity       String
  entityId     String?
  prevValue    Json?
  newValue     Json?
  createdAt    DateTime  @default(now())

  @@index([adminUserId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ─── Products ────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Collection {
  id               String              @id @default(cuid())
  name             String
  slug             String              @unique
  description      String?
  longDescription  String?
  imageUrl         String?
  heroImageUrl     String?
  seoTitle         String?
  seoDescription   String?
  ogImageUrl       String?
  sortOrder        Int                 @default(0)
  active           Boolean            @default(true)
  products         ProductCollection[]
  campaigns        CampaignCollection[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  products ProductTag[]
}

model Product {
  id                   String             @id @default(cuid())
  sku                  String             @unique
  title                String
  seoTitle             String?
  emotionalName        String?
  slug                 String             @unique
  shortDescription     String?
  longDescription      String?
  categoryId           String
  category             Category           @relation(fields: [categoryId], references: [id])
  style                String?
  occasion             String?
  material             String?
  plating              String?
  stone                String?
  dimensions           String?
  weightGrams          Decimal?           @db.Decimal(8, 2)
  careInstructions     String?
  mrp                  Decimal            @db.Decimal(12, 2)
  salePrice            Decimal?           @db.Decimal(12, 2)
  costPrice            Decimal            @db.Decimal(12, 2)
  taxRate              Decimal            @default(0) @db.Decimal(5, 2)
  hsnCode              String?
  status               ProductStatus      @default(DRAFT)
  isFeatured           Boolean            @default(false)
  isNewArrival         Boolean            @default(false)
  isBestSeller         Boolean            @default(false)
  isInDiscountSection  Boolean            @default(false)
  hasMultipleColours   Boolean            @default(false)
  publishedAt          DateTime?
  scheduledAt          DateTime?
  seoDescription       String?
  canonicalUrl         String?
  ogImageUrl           String?
  socialShareImageUrl  String?
  collections          ProductCollection[]
  tags                 ProductTag[]
  variants             ProductVariant[]
  media                ProductMedia[]
  inventory            Inventory?
  reviews              Review[]
  wishlistItems        WishlistItem[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  wearItWith           WearItWith[]       @relation("WearItWithSource")
  wearItWithRefs       WearItWith[]       @relation("WearItWithTarget")
  campaignProducts     CampaignProduct[]
  recentlyViewed       RecentlyViewed[]
  promotionProducts    PromotionProduct[]
  promotionExclusions  PromotionExclusion[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([slug])
  @@index([isNewArrival])
  @@index([isBestSeller])
  @@index([isInDiscountSection])
}

model ProductVariant {
  id           String        @id @default(cuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  colourName   String
  colourSwatch String?
  hexValue     String?
  sku          String        @unique
  price        Decimal?      @db.Decimal(12, 2)
  costPrice    Decimal?      @db.Decimal(12, 2)
  stock        Int           @default(0)
  status       ProductStatus @default(PUBLISHED)
  media        ProductMedia[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  inventory    VariantInventory?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([productId])
}

model ProductMedia {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url        String
  altText    String?
  mediaType  String          @default("image")
  sortOrder  Int             @default(0)
  width      Int?
  height     Int?
  createdAt  DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([productId, collectionId])
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model WearItWith {
  sourceId String
  source   Product @relation("WearItWithSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   Product @relation("WearItWithTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId])
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model Inventory {
  id           String                    @id @default(cuid())
  productId    String                    @unique
  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock        Int                       @default(0)
  lowStockAt   Int                       @default(5)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  adjustments  InventoryAdjustment[]
}

model VariantInventory {
  id          String                    @id @default(cuid())
  variantId   String                    @unique
  variant     ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stock       Int                       @default(0)
  lowStockAt  Int                       @default(5)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  adjustments InventoryAdjustment[]
}

model InventoryAdjustment {
  id                 String                    @id @default(cuid())
  inventoryId        String?
  inventory          Inventory?                @relation(fields: [inventoryId], references: [id])
  variantInventoryId String?
  variantInventory   VariantInventory?         @relation(fields: [variantInventoryId], references: [id])
  delta              Int
  reason             InventoryAdjustmentReason
  note               String?
  createdAt          DateTime                  @default(now())
}

// ─── Wishlist ─────────────────────────────────────────────────────────────────

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId])
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId  String?    @unique
  items      CartItem[]
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  expiresAt  DateTime?

  @@index([sessionId])
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  addedAt   DateTime        @default(now())

  @@unique([cartId, productId, variantId])
}

// ─── Promotions & Coupons ─────────────────────────────────────────────────────

model Promotion {
  id                  String               @id @default(cuid())
  name                String
  internalCode        String               @unique
  discountType        DiscountType
  discountValue       Decimal              @db.Decimal(10, 2)
  target              PromotionTarget      @default(ALL)
  startsAt            DateTime?
  endsAt              DateTime?
  usageLimit          Int?
  usageCount          Int                  @default(0)
  perCustomerLimit    Int                  @default(1)
  minimumSpend        Decimal?             @db.Decimal(12, 2)
  minimumEligibleSpend Decimal?            @db.Decimal(12, 2)
  stackable           Boolean              @default(false)
  firstOrderOnly      Boolean              @default(false)
  autoApply           Boolean              @default(false)
  active              Boolean              @default(true)
  eligibleProducts    PromotionProduct[]
  excludedProducts    PromotionExclusion[]
  coupons             Coupon[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model PromotionProduct {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
}

model PromotionExclusion {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
}

model Coupon {
  id           String             @id @default(cuid())
  code         String             @unique
  promotionId  String
  promotion    Promotion          @relation(fields: [promotionId], references: [id])
  userId       String?
  singleUse    Boolean            @default(false)
  source       String?
  expiresAt    DateTime?
  active       Boolean            @default(true)
  redemptions  CouponRedemption[]
  createdAt    DateTime           @default(now())

  @@index([code])
  @@index([userId])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String?
  createdAt DateTime @default(now())
}

// ─── Campaigns ────────────────────────────────────────────────────────────────

model Campaign {
  id                  String               @id @default(cuid())
  internalName        String
  headline            String
  subheadline         String?
  ctaText             String               @default("Shop Now")
  ctaUrl              String
  bannerImageUrl      String?
  mobileBannerUrl     String?
  videoUrl            String?
  bgColor             String?
  textColor           String?
  accentColor         String?
  badge               String?
  template            String               @default("editorial")
  campaignType        String               @default("general")
  startsAt            DateTime?
  endsAt              DateTime?
  countdownEnabled    Boolean              @default(false)
  status              String               @default("draft")
  scheduledPublishAt  DateTime?
  sortOrder           Int                  @default(0)
  products            CampaignProduct[]
  collections         CampaignCollection[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model CampaignProduct {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@id([campaignId, productId])
}

model CampaignCollection {
  campaignId   String
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([campaignId, collectionId])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id                String             @id @default(cuid())
  orderNumber       String             @unique
  userId            String?
  user              User?              @relation(fields: [userId], references: [id])
  addressId         String?
  address           Address?           @relation(fields: [addressId], references: [id])
  guestEmail        String?
  guestPhone        String?
  guestName         String?
  shippingAddress   Json
  billingAddress    Json?
  items             OrderItem[]
  subtotal          Decimal            @db.Decimal(12, 2)
  discountAmount    Decimal            @default(0) @db.Decimal(12, 2)
  shippingAmount    Decimal            @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal            @default(0) @db.Decimal(12, 2)
  total             Decimal            @db.Decimal(12, 2)
  couponCode        String?
  couponDiscount    Decimal?           @db.Decimal(12, 2)
  status            OrderStatus        @default(NEW)
  paymentStatus     PaymentStatus      @default(PENDING)
  payment           Payment?
  shipment          Shipment?
  statusHistory     OrderStatusHistory[]
  internalNotes     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id])
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  snapshotTitle   String
  snapshotSku     String
  snapshotColour  String?
  snapshotImageUrl String?
  snapshotMrp     Decimal         @db.Decimal(12, 2)
  snapshotPrice   Decimal         @db.Decimal(12, 2)
  snapshotCost    Decimal         @db.Decimal(12, 2)
  quantity        Int
  lineTotal       Decimal         @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id])
  gatewayOrderId  String?
  gatewayPaymentId String?
  gatewaySignature String?
  method          String?
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  failureReason   String?
  webhookEventId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([gatewayPaymentId])
  @@index([webhookEventId])
}

model Shipment {
  id               String    @id @default(cuid())
  orderId          String    @unique
  order            Order     @relation(fields: [orderId], references: [id])
  courier          String?
  trackingNumber   String?
  trackingUrl      String?
  awbNumber        String?
  shippedAt        DateTime?
  estimatedDelivery DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  guestName      String?
  guestEmail     String?
  rating         Int
  title          String?
  body           String
  imageUrl       String?
  verifiedPurchase Boolean   @default(false)
  status         ReviewStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([productId, status])
}

// ─── Newsletter ───────────────────────────────────────────────────────────────

model NewsletterSubscriber {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  status       String    @default("active")
  source       String?
  subscribedAt DateTime  @default(now())
  unsubscribedAt DateTime?
}

model NewsletterCampaign {
  id           String    @id @default(cuid())
  subject      String
  previewText  String?
  htmlContent  String
  plainText    String?
  status       String    @default("draft")
  sentAt       DateTime?
  scheduledAt  DateTime?
  recipientCount Int     @default(0)
  openCount    Int       @default(0)
  clickCount   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── Abandoned Cart ───────────────────────────────────────────────────────────

model AbandonedCartEvent {
  id                  String    @id @default(cuid())
  userId              String?
  user                User?     @relation(fields: [userId], references: [id])
  sessionId           String?
  email               String?
  cartSnapshot        Json
  eligibleSubtotal    Decimal   @db.Decimal(12, 2)
  discountedSubtotal  Decimal   @db.Decimal(12, 2)
  totalValue          Decimal   @db.Decimal(12, 2)
  email24hSentAt      DateTime?
  email5dSentAt       DateTime?
  discountCode        String?
  recoveredAt         DateTime?
  recoveredOrderId    String?
  recoveredRevenue    Decimal?  @db.Decimal(12, 2)
  lastActivityAt      DateTime  @default(now())
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([email])
  @@index([lastActivityAt])
}

// ─── Analytics ────────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  event      String
  userId     String?
  sessionId  String?
  data       Json
  createdAt  DateTime @default(now())

  @@index([event])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

model SearchEvent {
  id          String   @id @default(cuid())
  query       String
  resultsCount Int
  userId      String?
  sessionId   String?
  createdAt   DateTime @default(now())

  @@index([query])
  @@index([createdAt])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ─── CMS / Content ────────────────────────────────────────────────────────────

model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   Json
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model HomepageSection {
  id        String   @id @default(cuid())
  sectionKey String  @unique
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  config    Json
  updatedAt DateTime @updatedAt
}

model Media {
  id          String   @id @default(cuid())
  url         String
  publicId    String?
  filename    String
  altText     String?
  mimeType    String
  fileSize    Int
  width       Int?
  height      Int?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
}
